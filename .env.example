# Copie para .env e preencha. NUNCA commite o .env nem cole valores reais neste arquivo.

# carteira de deploy: chave privada (0x + 64 hex) de uma conta limpa, só pra os 3 tx de deploy
DEPLOYER_PK=

# RPC (Alchemy, oficial ou publicnode)
RH_RPC=https://robinhood-rpc.publicnode.com
RH_TESTNET_RPC=https://robinhood-sepolia-rpc.publicnode.com

# --- passo 1: FeeSplitter ---
# tesouraria: endereco que recebe os 60%. IMUTAVEL depois do deploy. Pode ser carteira fria.
TREASURY=
TREASURY_BPS=6000

# --- passo 3: BondEngine (depois do launch na Pons) ---
# guardian: so pausa entradas (max 7 dias) e propoe parametros com 48h. Pode ser a mesma carteira da tesouraria.
GUARDIAN=
# token criado na Pons e splitter do passo 1
TOKEN=
SPLITTER=

# --- passo 4: keeper ---
ENGINE=
